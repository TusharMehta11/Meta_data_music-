# Copy to .env and fill in. Real environment variables override this file.

# Where the music is: a local folder or an FTP/FTPS URL
MUSIC_SOURCE=ftp://182.18.0.249:2221/Music/
FTP_USER=your_ftp_username
FTP_PASSWORD=your_ftp_password
# FTP_TLS=1            # explicit FTPS, if the server supports it

# Local LLM (Ollama)
OLLAMA_URL=http://localhost:11434
LLM_MODEL=qwen3:4b

# iTunes store country used for searches (IN works well for Indian + international music)
ITUNES_COUNTRY=IN
